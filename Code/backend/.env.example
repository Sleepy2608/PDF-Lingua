# --- Application Configuration ---
APP_NAME=PDF-Lingua
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# --- Security & JWT Authentication ---
# Generate a secure 32+ character key for production (e.g. openssl rand -hex 32)
SECRET_KEY=dev-secret-key-pdf-lingua-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database Configuration ---
# SQLite (default for development):
DATABASE_URL=sqlite:///./pdf_lingua.db
# PostgreSQL (production / optional):
# DATABASE_URL=postgresql://user:password@localhost:5432/pdf_lingua

# --- File Upload & Processing Constraints ---
UPLOAD_DIR=temp_uploads/
MAX_UPLOAD_SIZE_FREE_MB=20
MAX_UPLOAD_SIZE_PRO_MB=100
MAX_PAGES_FREE=100
MAX_PAGES_PRO=500

# --- OCR Configuration (Tesseract) ---
# Path to Tesseract binary if not in system PATH (e.g., C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=
DEFAULT_OCR_LANG=vie+eng

# --- Translation Service Configuration ---
TRANSLATION_ENGINE=deep-translator
TRANSLATION_DEFAULT_TARGET=vi

# --- AI Services (Pro Features: Summarization & Document QA) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL_SUMMARIZE=gemini-2.0-flash
AI_MODEL_CHAT=gemini-2.0-flash
AI_MAX_TOKENS=2048
AI_DAILY_LIMIT_PRO=50

# --- Frontend CORS Integration ---
FRONTEND_ORIGIN=http://localhost:5500
