# Application Configuration
APP_NAME=PDF-Lingua
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# OCR Configuration
# Path to Tesseract binary if not in system PATH (e.g., C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=
DEFAULT_OCR_LANG=vie+eng

# Translation Service Configuration
TRANSLATION_ENGINE=googletrans
# Optional API Key if using cloud translation services (e.g. OpenAI, DeepL, Google Cloud)
TRANSLATION_API_KEY=

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=temp_uploads/
