# --- Application Configuration ---
APP_NAME=PDF-Lingua
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# --- Security & JWT Authentication ---
# Generate a secure 32+ character key for production (e.g. openssl rand -hex 32)
SECRET_KEY=dev-secret-key-pdf-lingua-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database Configuration ---
# SQLite (default for development):
DATABASE_URL=sqlite:///./pdf_lingua.db
# PostgreSQL (production / optional):
# DATABASE_URL=postgresql://user:password@localhost:5432/pdf_lingua

# --- File Upload & Processing Constraints ---
UPLOAD_DIR=temp_uploads/
MAX_UPLOAD_SIZE_FREE_MB=20
MAX_UPLOAD_SIZE_PRO_MB=100
MAX_PAGES_FREE=100
MAX_PAGES_PRO=500

# --- OCR Configuration (Tesseract) ---
# Path to Tesseract binary if not in system PATH (e.g., C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=
DEFAULT_OCR_LANG=vie+eng

# --- Translation Service Configuration ---
TRANSLATION_ENGINE=deep-translator
TRANSLATION_DEFAULT_TARGET=vi

# --- AI Services (Pro Features: Summarization & Document QA) ---
# PDF-Lingua giao tiếp qua giao thức chuẩn tương thích OpenAI /v1/chat/completions.
# Bạn có thể sử dụng bất kỳ nhà cung cấp LLM nào: B.AI, OpenAI, OpenRouter, Google Gemini, hoặc Ollama (Local).
# LƯU Ý: Nếu không điền API Key, hệ thống tự động chạy ở chế độ Offline Fallback (không gây lỗi).

AI_PROVIDER=b.ai
BAI_API_KEY=
BAI_BASE_URL=https://api.b.ai/v1
BAI_MODEL_SUMMARIZE=gpt-5-mini
BAI_MODEL_CHAT=gpt-5-mini

# --- Cấu hình tùy chọn theo từng nhà cung cấp (Bỏ comment để dùng) ---
# 1. Dùng OpenAI chính thức:
# BAI_BASE_URL=https://api.openai.com/v1
# BAI_API_KEY=sk-...
# BAI_MODEL_SUMMARIZE=gpt-4o-mini
# BAI_MODEL_CHAT=gpt-4o-mini

# 2. Dùng OpenRouter (Nhiều model miễn phí):
# BAI_BASE_URL=https://openrouter.ai/api/v1
# BAI_API_KEY=sk-or-v1-...
# BAI_MODEL_SUMMARIZE=google/gemini-2.0-flash-exp:free
# BAI_MODEL_CHAT=google/gemini-2.0-flash-exp:free

# 3. Dùng Google Gemini (OpenAI Endpoint):
# BAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# BAI_API_KEY=AIzaSy...
# BAI_MODEL_SUMMARIZE=gemini-2.0-flash
# BAI_MODEL_CHAT=gemini-2.0-flash

# 4. Dùng Ollama chạy Offline 100% trên máy:
# BAI_BASE_URL=http://localhost:11434/v1
# BAI_API_KEY=ollama
# BAI_MODEL_SUMMARIZE=llama3.2
# BAI_MODEL_CHAT=llama3.2

GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MAX_TOKENS=2048
AI_DAILY_LIMIT_PRO=50

# --- Frontend CORS Integration ---
FRONTEND_ORIGIN=http://localhost:5500
